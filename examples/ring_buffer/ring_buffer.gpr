with "sparklib";

project Ring_Buffer is

   --  RING_BUFFER_SRC selects the implementation directory under analysis.
   --  It defaults to the positive baseline in "src". The negative-fixture
   --  gate (scripts/check_proof_results.py) materialises each broken
   --  variant (src + one negative/<name>/fault.toml patch) under
   --  "obj/negative_src/<name>" and points this variable at it, using
   --  RING_BUFFER_VARIANT to keep each variant's object/proof artifacts
   --  isolated from the baseline.
   --
   --  RING_BUFFER_REPR selects which private representation is the default
   --  implementation (Task 002). Both share the identical public spec, the
   --  client proof in "proof" and the runtime tests in "tests":
   --
   --    first_length     Task 001 baseline  src/                      (default)
   --    head_tail_count  Task 002           variants/head_tail_count/
   --
   --  Each representation has its own object and executable directories, so
   --  building one never overwrites the other.
   type Representation_Kind is ("first_length", "head_tail_count");
   Representation : Representation_Kind :=
     external ("RING_BUFFER_REPR", "first_length");

   Default_Impl_Dir := "src";
   Default_Variant  := "baseline";
   Bin_Dir          := "bin";
   case Representation is
      when "first_length" =>
         null;
      when "head_tail_count" =>
         Default_Impl_Dir := "variants/head_tail_count";
         Default_Variant  := "head_tail_count";
         Bin_Dir          := "bin/head_tail_count";
   end case;

   Impl_Dir := external ("RING_BUFFER_SRC", Default_Impl_Dir);
   Variant  := external ("RING_BUFFER_VARIANT", Default_Variant);

   --  RING_BUFFER_ASSERTIONS=on builds the runtime tests with -gnata, so
   --  that every contract (including the ghost Model and the SPARKlib
   --  functional-sequence equalities in Push/Pop/Peek postconditions) is
   --  also executed at run time. The default (off) is the production
   --  configuration: ghost code is not compiled into the executable.
   type On_Off is ("on", "off");
   Assertions : On_Off := external ("RING_BUFFER_ASSERTIONS", "off");

   for Source_Dirs use (Impl_Dir, "proof", "tests");
   for Main use ("ring_buffer_runtime_tests.adb");

   Common_Switches := ("-gnat2022", "-gnatwa", "-gnatW8", "-g");

   case Assertions is
      when "off" =>
         for Object_Dir use "obj/" & Variant;
         for Exec_Dir use Bin_Dir;
      when "on" =>
         for Object_Dir use "obj/" & Variant & "-assertions";
         for Exec_Dir use Bin_Dir & "/assertions";
   end case;

   package Compiler is
      case Assertions is
         when "off" =>
            for Default_Switches ("Ada") use Common_Switches;
         when "on" =>
            for Default_Switches ("Ada") use Common_Switches & ("-gnata");
      end case;
   end Compiler;

   package Prove is
      --  -U                   analyse every unit (package, client proof)
      --  --level=2            cvc5,z3,altergo; timeout 5 s; no step limit
      --  --no-loop-unrolling  do not let the fixed Max_Size = 16 unroll the
      --                       model-construction loop; the recorded loop
      --                       invariants must carry the proof, as they would
      --                       for any realistic capacity
      for Proof_Switches ("Ada") use
        ("-U", "--mode=all", "--level=2", "--no-loop-unrolling",
         "--report=statistics", "--checks-as-errors=on",
         "--warnings=error");
   end Prove;

end Ring_Buffer;
