project Runtime is
   Upstream := external ("UPSTREAM");
   for Source_Dirs use (".", Upstream & "/src", Upstream & "/src/security");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("sha256_driver.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat12", "-gnatwa");
   end Compiler;
end Runtime;