--  Task 013 guard-sensitive conjunct re-proof EXPERIMENT corpus (not
--  product code, not a benchmark). Pre-registered in
--  docs/tasks/013-guard-sensitive-conjunct-reproof.md; analysed only by
--  diagnostics/scripts/guarded_reproof_experiment.py on scratch copies.
project Guarded is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   package Prove is
      for Proof_Switches ("Ada") use
        ("-U", "--mode=all", "--level=2", "--report=statistics");
   end Prove;
end Guarded;
