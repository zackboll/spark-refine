--  Task 014 Ada call-binding conjunct re-proof EXPERIMENT corpus (not
--  product code, not a benchmark). Pre-registered in
--  docs/tasks/014-ada-call-binding-reproof.md; analysed only by
--  diagnostics/scripts/call_binding_reproof_experiment.py on scratch copies.
project Call_Binding is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   package Prove is
      for Proof_Switches ("Ada") use
        ("-U", "--mode=all", "--level=2", "--report=statistics");
   end Prove;
end Call_Binding;
